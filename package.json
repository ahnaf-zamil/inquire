{
  "name": "search-engine",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "dev:crawler": "cd services/crawler && npm run dev",
    "dev:search": "cd services/search-api && npm run dev",
    "build:crawler": "cd services/crawler && npm run build",
    "build:search": "cd services/search-api && npm run build",
    "load-seeds": "cd services/crawler && npm run load-seeds",
    "reindex": "cd services/crawler && npm run reindex",
    "dev:web": "cd apps/web && bun run dev",
    "build:web": "cd apps/web && bun run build"
  },
  "devDependencies": {
    "shadcn": "^4.16.2",
    "typescript": "^5.0.0"
  }
}
