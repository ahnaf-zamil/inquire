{
  "name": "search-engine",
  "private": true,
  "workspaces": [
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev:crawler": "bun run --cwd services/crawler dev",
    "dev:search": "bun run --cwd services/search-api dev",
    "build:crawler": "bun run --cwd services/crawler build",
    "build:search": "bun run --cwd services/search-api build",
    "load-seeds": "bun run --cwd services/crawler load-seeds",
    "reindex": "bun run --cwd services/crawler reindex",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "start:web": "bun run --cwd apps/web start"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
