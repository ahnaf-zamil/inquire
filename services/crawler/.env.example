# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX=pages

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Crawler Settings
CRAWLER_WORKERS=15
PLAYWRIGHT_WORKERS=5

# Rate Limiting
DOMAIN_DELAY_MS=200
GLOBAL_RPS=10

# Timeouts (ms)
HTTP_FETCH_TIMEOUT=30000
PLAYWRIGHT_TIMEOUT=60000
QUEUE_TIMEOUT=5000
WORKER_TIMEOUT=120000

# Playwright Options
PLAYWRIGHT_HEADLESS=true
# PLAYWRIGHT_PROXY=http://proxy:8080

# Logging
LOG_LEVEL=info
# LOG_FILE=crawler.log
