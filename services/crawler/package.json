{
  "name": "crawler-service",
  "version": "1.0.0",
  "description": "Web crawler with Playwright support for indexing pages",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
